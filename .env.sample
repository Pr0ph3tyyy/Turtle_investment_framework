# Tushare Pro API Token
# Get yours at: https://tushare.pro/register
TUSHARE_TOKEN=your_token_here

# Optional: delay (seconds) between Tushare API calls (default: 0.5).
# Set to 0 to disable throttling when using a broker/VIP endpoint with no
# rate limit, which greatly speeds up data collection.
# TUSHARE_RATE_DELAY=0.5

# Optional: explicit 10-year risk-free rate in percent.
# Needed when the yc_cb endpoint has no permission. Without a rate, the
# pre-computed blocks that depend on it (业绩下滑敏感性 / 穿透回报率网格 /
# 收入敏感性) cannot be generated and the data pack says so explicitly.
# Equivalent to passing --rf on the command line.
# TUSHARE_RF=1.688